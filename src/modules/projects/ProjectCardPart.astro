---
// Project card: icon tile, title, role line, description, and tag chips.
import { Icon } from 'astro-icon/components';
import type { Project } from '@data/profile';

interface Props {
  project: Project;
  icon: string;
}

const { project, icon } = Astro.props;
---

<article class="card card-lift flex flex-col p-6">
  <div class="icon-tile mb-3">
    <Icon name={icon} class="h-5 w-5" aria-hidden="true" />
  </div>
  <h2 class="title-item text-lg">{project.title}</h2>
  <p class="text-accent mt-1 text-sm">{project.role}</p>
  <p class="text-muted mt-3 grow text-sm leading-relaxed">
    {project.description}
  </p>
  {
    Astro.slots.has('diagram') && (
      <div class="mt-4">
        <slot name="diagram" />
      </div>
    )
  }
  <div class="mt-4 flex flex-wrap gap-2">
    {project.tags.map((t) => <span class="tag">{t}</span>)}
  </div>
</article>
