---
// Project card: icon tile, title, role line, description, and tag chips.
import { Icon } from 'astro-icon/components';
import type { Project } from '../../data/profile';

interface Props {
  project: Project;
  icon: string;
}

const { project, icon } = Astro.props;
---

<article class="card card-lift p-6 flex flex-col">
  <div class="icon-tile mb-3">
    <Icon name={icon} class="h-5 w-5" aria-hidden="true" />
  </div>
  <h2 class="title-item text-lg">{project.title}</h2>
  <p class="mt-1 text-sm text-indigo-600 dark:text-indigo-400">{project.role}</p>
  <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300 grow">
    {project.description}
  </p>
  <div class="mt-4 flex flex-wrap gap-2">
    {project.tags.map((t) => (
      <span class="tag">
        {t}
      </span>
    ))}
  </div>
</article>
