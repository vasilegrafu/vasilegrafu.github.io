---
// Project card: icon tile, title, role line, description, and tag chips.
import { Icon } from 'astro-icon/components';
import type { Project } from '../../data/profile';

interface Props {
  project: Project;
  icon: string;
}

const { project, icon } = Astro.props;
---

<article class="card-lift rounded-xl border border-slate-200 dark:border-slate-800 p-6 flex flex-col">
  <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400">
    <Icon name={icon} class="h-5 w-5" aria-hidden="true" />
  </div>
  <h2 class="font-display text-lg font-semibold text-slate-900 dark:text-white">{project.title}</h2>
  <p class="mt-1 text-sm text-indigo-600 dark:text-indigo-400">{project.role}</p>
  <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300 grow">
    {project.description}
  </p>
  <div class="mt-4 flex flex-wrap gap-2">
    {project.tags.map((t) => (
      <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-3 py-1 text-xs text-slate-600 dark:text-slate-300">
        {t}
      </span>
    ))}
  </div>
</article>
