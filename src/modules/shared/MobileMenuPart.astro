---
// Dropdown nav panel shown below the header on mobile; opened by MenuButton.
import { Icon } from 'astro-icon/components';
import { navItems } from './nav';
import { isActive } from '@fx/lib/routing';

const path = Astro.url.pathname;
---

<div id="mobile-menu" class="border-line hidden border-t sm:hidden">
  <nav class="mx-auto flex max-w-4xl flex-col gap-1 px-4 py-3 text-sm">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class:list={['menu-item', isActive(item.href, path) && 'menu-item-active']}
        >
          <Icon name={item.icon} class="h-4.5 w-4.5" aria-hidden="true" />
          {item.label}
        </a>
      ))
    }
  </nav>
</div>

<script is:inline>
  document.getElementById('menu-toggle').addEventListener('click', function () {
    var menu = document.getElementById('mobile-menu');
    var open = menu.classList.toggle('hidden') === false;
    document.getElementById('menu-icon-open').classList.toggle('hidden', open);
    document.getElementById('menu-icon-close').classList.toggle('hidden', !open);
    this.setAttribute('aria-expanded', open ? 'true' : 'false');
    this.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
