---
import { navItems } from './nav';
import { site } from '../../data/profile';
---

<footer class="border-t border-slate-200 dark:border-slate-800">
  <div class="mx-auto max-w-4xl px-4 py-8">
    <div class="flex flex-wrap items-start justify-between gap-6">
      <div>
        <p class="font-display font-semibold text-slate-900 dark:text-white">Vasile Grafu</p>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400 max-w-xs">
          Engineering leadership, software architecture, and applied AI.
        </p>
      </div>
      <nav class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-600 dark:text-slate-400">
        {
          navItems.map((item) => (
            <a href={item.href} class="hover:text-indigo-600 dark:hover:text-indigo-400">
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
    <p class="mt-6 text-sm text-slate-500 dark:text-slate-400">
      © {new Date().getFullYear()} {site.name} ·
      <a href={site.github} class="hover:text-indigo-600 dark:hover:text-indigo-400">GitHub</a> ·
      <a href={site.linkedin} class="hover:text-indigo-600 dark:hover:text-indigo-400">LinkedIn</a> ·
      <a href="/rss.xml" class="hover:text-indigo-600 dark:hover:text-indigo-400">RSS</a>
    </p>
  </div>
</footer>
