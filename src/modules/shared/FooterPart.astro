---
import { navItems } from './nav';
import { site } from '@data/profile';
---

<footer class="border-line border-t">
  <div class="mx-auto max-w-4xl px-4 py-8">
    <div class="flex flex-wrap items-start justify-between gap-6">
      <div>
        <p class="font-display text-ink font-semibold">Vasile Grafu</p>
        <p class="text-faint mt-1 max-w-xs text-sm">
          Engineering leadership, software architecture, and applied AI.
        </p>
      </div>
      <nav class="text-muted flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {
          navItems.map((item) => (
            <a href={item.href} class="hover:text-accent">
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
    <p class="text-faint mt-6 text-sm">
      © {new Date().getFullYear()}
      {site.name} ·
      <a href={site.github} class="hover:text-accent">GitHub</a> ·
      <a href={site.linkedin} class="hover:text-accent">LinkedIn</a> ·
      <a href="/rss.xml" class="hover:text-accent">RSS</a>
    </p>
  </div>
</footer>
