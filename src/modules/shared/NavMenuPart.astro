---
// Desktop pill navigation.
import { Icon } from 'astro-icon/components';
import { navItems } from './nav';
import { isActive } from '@fx/lib/routing';

const path = Astro.url.pathname;
---

<nav class="hidden flex-wrap gap-1 text-sm sm:flex">
  {
    navItems.map((item) => (
      <a href={item.href} class:list={['nav-pill', isActive(item.href, path) && 'nav-pill-active']}>
        <Icon name={item.icon} class="h-4 w-4" aria-hidden="true" />
        {item.label}
      </a>
    ))
  }
</nav>
