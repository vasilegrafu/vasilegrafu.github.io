---
// Theme dropdown: lists every registered theme (src/themes/themes.ts) and
// shows the active one on the button. Light is the default; the choice is
// stored in localStorage and applied before first paint by the inline script
// in BaseLayout's <head>.
import { Icon } from 'astro-icon/components';
import { themes } from '@themes/themes';
---

<div class="relative">
  <button
    id="theme-menu-btn"
    type="button"
    aria-label="Change theme"
    aria-haspopup="menu"
    aria-expanded="false"
    data-tip="Change the site's color theme"
    class="tip tip-end border-line-strong text-muted hover:border-accent hover:text-accent inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs font-medium transition-colors"
  >
    <Icon name="lucide:palette" class="h-4 w-4" aria-hidden="true" />
    <span id="theme-menu-label">Light</span>
    <Icon
      name="lucide:chevron-down"
      class="h-3.5 w-3.5 transition-transform [[aria-expanded='true']_&]:rotate-180"
      aria-hidden="true"
    />
  </button>

  <div
    id="theme-menu"
    role="menu"
    class="card bg-bg absolute top-full right-0 z-20 mt-2 hidden w-44 p-1 shadow-lg"
  >
    {
      themes.map((t) => (
        <button
          type="button"
          role="menuitemradio"
          data-theme-id={t.id}
          class="theme-item menu-item text-sm"
        >
          <span
            class="border-line-strong h-3.5 w-3.5 rounded-full border"
            style={`background:${t.swatch}`}
            aria-hidden="true"
          />
          <span class="grow text-start">{t.label}</span>
          <Icon
            name="lucide:check"
            class="theme-check text-accent hidden h-4 w-4"
            aria-hidden="true"
          />
        </button>
      ))
    }
  </div>
</div>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-menu-btn');
    var menu = document.getElementById('theme-menu');
    var label = document.getElementById('theme-menu-label');
    var items = menu.querySelectorAll('.theme-item');

    function current() {
      try {
        return localStorage.getItem('theme') || 'light';
      } catch (e) {
        return 'light';
      }
    }
    function sync() {
      var active = current();
      items.forEach(function (item) {
        var isActive = item.getAttribute('data-theme-id') === active;
        item.querySelector('.theme-check').classList.toggle('hidden', !isActive);
        item.setAttribute('aria-checked', isActive ? 'true' : 'false');
        if (isActive) label.textContent = item.querySelector('.grow').textContent;
      });
    }
    function close() {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    }

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      var open = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    document.addEventListener('click', function (e) {
      if (!menu.contains(e.target) && e.target !== btn) close();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') close();
    });

    items.forEach(function (item) {
      item.addEventListener('click', function () {
        var id = item.getAttribute('data-theme-id');
        try {
          localStorage.setItem('theme', id);
        } catch (e) {}
        document.documentElement.setAttribute('data-theme', id);
        sync();
        close();
      });
    });

    sync();
  })();
</script>
