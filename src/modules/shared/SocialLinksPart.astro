---
// Mail / GitHub / LinkedIn icon links shown in the header.
import { Icon } from 'astro-icon/components';
import { site } from '../../data/profile';
---

<div class="flex items-center gap-3 text-slate-500 dark:text-slate-400">
  <a
    href={`mailto:${site.email}`}
    aria-label="Email"
    data-tip="Send me an email"
    class="tip hover:text-indigo-600 dark:hover:text-indigo-400"
  >
    <Icon name="lucide:mail" class="h-4.5 w-4.5" aria-hidden="true" />
  </a>
  <a
    href={site.github}
    aria-label="GitHub"
    data-tip="My code on GitHub"
    class="tip hover:text-indigo-600 dark:hover:text-indigo-400"
  >
    <Icon name="lucide:github" class="h-4.5 w-4.5" aria-hidden="true" />
  </a>
  <a
    href={site.linkedin}
    aria-label="LinkedIn"
    data-tip="My LinkedIn profile"
    class="tip hover:text-indigo-600 dark:hover:text-indigo-400"
  >
    <Icon name="lucide:linkedin" class="h-4.5 w-4.5" aria-hidden="true" />
  </a>
</div>
