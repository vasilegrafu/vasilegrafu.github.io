---
import Base from '../../layouts/Base.astro';
import { articlesByDate } from './registry';

const articles = articlesByDate();
---

<Base title="Articles — Vasile Grafu" description="Writing on engineering leadership, software architecture, and applied AI.">
  <p class="kicker">Writing</p>
  <h1 class="mt-2 font-display text-3xl font-bold text-slate-900 dark:text-white">Articles</h1>
  <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">
    Writing on engineering leadership, software architecture, agentic AI systems, and
    AI-assisted development. Subscribe via <a href="/rss.xml" class="text-indigo-600 dark:text-indigo-400 hover:underline">RSS</a>.
  </p>

  <ul class="mt-8 space-y-8">
    {
      articles.map((article) => (
        <li>
          <a href={`/articles/${article.id}/`} class="group block">
            <p class="text-sm text-slate-500 dark:text-slate-400">
              {article.pubDate.toLocaleDateString('en-GB', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </p>
            <h2 class="mt-1 font-display text-xl font-semibold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400">
              {article.title}
            </h2>
            <p class="mt-2 text-slate-600 dark:text-slate-300">{article.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
