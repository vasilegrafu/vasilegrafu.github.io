---
import Base from '../../layouts/Base.astro';
import { articles, type ArticleMeta } from './registry';

export async function getStaticPaths() {
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

interface Props {
  article: ArticleMeta;
}

const { article } = Astro.props;

// Resolve the article's content component by convention:
// content/<id>/ArticlePart.astro
const contentModules = import.meta.glob<{ default: any }>('./content/*/ArticlePart.astro', {
  eager: true,
});
const Content = contentModules[`./content/${article.id}/ArticlePart.astro`].default;
---

<Base title={`${article.title} — Vasile Grafu`} description={article.description}>
  <article>
    <p class="text-sm text-faint">
      {
        article.pubDate.toLocaleDateString('en-GB', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })
      }
    </p>
    <h1 class="mt-2 title-page">{article.title}</h1>
    {
      article.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {article.tags.map((t) => (
            <span class="tag">
              {t}
            </span>
          ))}
        </div>
      )
    }
    <div class="prose-article mt-8">
      <Content />
    </div>
  </article>
  <p class="mt-10">
    <a href="/articles/" class="link-accent">← All articles</a>
  </p>
</Base>
