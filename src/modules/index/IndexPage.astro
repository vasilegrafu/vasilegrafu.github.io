---
import BaseLayout from '@modules/shared/BaseLayout.astro';
import ChipPart from '@fx/components/ChipPart.astro';
import IconCardPart from '@fx/components/IconCardPart.astro';
import IconListItemPart from '@fx/components/IconListItemPart.astro';
import { site, experience } from '@data/profile';

const current = experience[0];
---

<BaseLayout title="Vasile Grafu — Engineering Manager & AI Systems Builder">
  <section class="relative py-10 sm:py-14">
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="blob bg-blob-a -top-24 -right-24 h-80 w-80"></div>
      <div class="blob bg-blob-b top-32 -left-24 h-64 w-64"></div>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-8 lg:flex-nowrap">
      <div class="max-w-2xl min-w-0">
        <p class="text-accent font-medium">Hello, I’m</p>
        <h1 class="title-hero mt-1">
          {site.name}
        </h1>
        <p class="text-muted mt-3 text-xl">{site.title}</p>
        <p class="mt-5 text-lg leading-relaxed">
          {site.tagline}
        </p>
        <div class="mt-6 flex flex-wrap gap-2 text-sm">
          <ChipPart icon="lucide:map-pin">{site.location}</ChipPart>
          <ChipPart icon="lucide:clock">20+ years in software</ChipPart>
          <ChipPart icon="lucide:briefcase">Engineering Manager @ nShift</ChipPart>
        </div>
      </div>
      <div class="hidden shrink-0 items-center justify-center lg:flex" aria-hidden="true">
        <div
          class="from-grad-a to-grad-b shadow-accent-solid/20 rounded-full bg-gradient-to-br p-1 shadow-xl"
        >
          <div class="bg-bg flex h-36 w-36 items-center justify-center rounded-full">
            <span
              class="font-display from-grad-a to-grad-b bg-gradient-to-br bg-clip-text text-4xl font-bold text-transparent"
              >VG</span
            >
          </div>
        </div>
      </div>
    </div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/career/" class="btn btn-primary"> My career story </a>
      <a href="/articles/" class="btn btn-ghost"> Read my writing </a>
    </div>
  </section>

  <section class="py-8">
    <p class="kicker">What I do</p>
    <div class="mt-4 grid gap-6 sm:grid-cols-3">
      <IconCardPart icon="lucide:users" title="Engineering leadership">
        Leading one of {current.company.split(' ')[0]}’s core teams — hiring, mentoring, and
        building the engineering culture behind business-critical delivery software.
      </IconCardPart>
      <IconCardPart icon="lucide:sparkles" title="AI systems">
        Building agentic AI platforms — LLM orchestration, RAG pipelines, and multi-agent
        architectures grounded in real business data.
      </IconCardPart>
      <IconCardPart icon="lucide:code-xml" title="Hands-on architect">
        Solutions Architect who still codes — C#/.NET, Python, React, and the AWS infrastructure it
        all runs on.
      </IconCardPart>
    </div>
  </section>

  <section class="py-8">
    <p class="kicker">Principles</p>
    <h2 class="title-section mt-2">What drives me</h2>
    <ul class="text-muted mt-4 space-y-3">
      <IconListItemPart icon="lucide:compass" title="Curiosity.">
        I’m naturally driven to understand how things work and why they work the way they do. I
        enjoy going deep into a problem, learning from first principles, and connecting ideas across
        different areas. For me, the process of understanding is rewarding in itself.
      </IconListItemPart>
      <IconListItemPart icon="lucide:trending-up" title="Constant evolution.">
        I’m always looking for ways to improve how I think, work, and build. AI-assisted engineering
        has already reshaped my daily practice, and I actively explore new tools, ideas, and
        approaches that can make me more effective. I see change as an opportunity to rethink what’s
        possible rather than simply adapt to it.
      </IconListItemPart>
      <IconListItemPart icon="lucide:users" title="Teams that discover.">
        I do my best work in supportive, collaborative teams where people learn from each other,
        challenge ideas constructively, and take pride in their craft. I value working toward a
        shared goal while giving everyone the space to contribute, experiment, and grow.
      </IconListItemPart>
      <IconListItemPart icon="lucide:target" title="Impact.">
        Technology is most interesting to me when it matters — when the systems we build carry real
        businesses, save people time, and open possibilities that weren’t there before.
        Understanding why the work matters shapes how I build it, and seeing an idea become
        something people rely on every day is the most satisfying part of engineering.
      </IconListItemPart>
    </ul>
  </section>
</BaseLayout>
