---
// One entry on the Career timeline: era icon, period badge, summary,
// collapsible "What I did" achievement cards, and tech chips.
import { Icon } from 'astro-icon/components';
import type { Role } from '../../data/profile';

interface Props {
  role: Role;
  icon: string;
}

const { role, icon } = Astro.props;
---

<li class="ms-6">
  <span class="absolute -start-3.5 mt-1 flex h-7 w-7 items-center justify-center rounded-full border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 text-indigo-600 dark:text-indigo-400">
    <Icon name={icon} class="h-4 w-4" aria-hidden="true" />
  </span>
  <p class="flex flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
    <span class="rounded-full bg-amber-50 dark:bg-amber-950/40 px-2.5 py-0.5 text-xs font-medium text-amber-700 dark:text-amber-300">{role.period}</span>
    {role.location}
  </p>
  <h2 class="mt-2 font-display text-xl font-semibold text-slate-900 dark:text-white">
    {role.position} · {role.company}
  </h2>
  <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-300">{role.summary}</p>
  <details class="mt-4">
    <summary class="inline-flex cursor-pointer select-none items-center gap-1.5 rounded-full border border-slate-200 dark:border-slate-700 px-4 py-1.5 text-sm font-medium text-indigo-600 dark:text-indigo-400 transition-colors hover:border-indigo-600 hover:bg-indigo-50/50 dark:hover:border-indigo-400 dark:hover:bg-indigo-950/40 list-none [&::-webkit-details-marker]:hidden">
      What I did
      <Icon name="lucide:chevron-down" class="chev h-4 w-4 transition-transform" aria-hidden="true" />
    </summary>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {role.bullets.map((b) => {
        const idx = b.indexOf(': ');
        const title = idx > 0 ? b.slice(0, idx) : null;
        const rest = idx > 0 ? b.slice(idx + 2) : b;
        const body = title ? rest.charAt(0).toUpperCase() + rest.slice(1) : rest;
        return (
          <div class="card-lift rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 p-4">
            {title && <p class="text-sm font-semibold text-slate-900 dark:text-white">{title}</p>}
            <p class={`text-sm leading-relaxed text-slate-600 dark:text-slate-300 ${title ? 'mt-1' : ''}`}>{body}</p>
          </div>
        );
      })}
    </div>
  </details>
  {role.tech && (
    <div class="mt-4 flex flex-wrap gap-2">
      {role.tech.map((t) => (
        <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-3 py-1 text-xs text-slate-600 dark:text-slate-300">
          {t}
        </span>
      ))}
    </div>
  )}
</li>
