---
import Base from '../layouts/Base.astro';
import { projects } from '../data/profile';
---

<Base title="Projects — Vasile Grafu" description="Selected systems: enterprise AI platforms, high-throughput web services, and e-commerce integrations.">
  <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Projects</h1>
  <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">
    The systems I’m proudest of — what they do, the scale they run at, and the architecture
    behind them.
  </p>

  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    {
      projects.map((p) => (
        <article class="rounded-xl border border-slate-200 dark:border-slate-800 p-6 flex flex-col">
          <h2 class="text-lg font-semibold text-slate-900 dark:text-white">{p.title}</h2>
          <p class="mt-1 text-sm text-indigo-600 dark:text-indigo-400">{p.role}</p>
          <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300 grow">
            {p.description}
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            {p.tags.map((t) => (
              <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-3 py-1 text-xs text-slate-600 dark:text-slate-300">
                {t}
              </span>
            ))}
          </div>
        </article>
      ))
    }
  </div>

  <p class="mt-10 text-slate-600 dark:text-slate-300">
    Open-source experiments and AI demos are coming to this page — watch
    <a href="https://github.com/vasilegrafu" class="text-indigo-600 dark:text-indigo-400 hover:underline">my GitHub</a>.
  </p>
</Base>
