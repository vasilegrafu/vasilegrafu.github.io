---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { projects } from '../data/profile';

// Lucide icon per project, in the same order as `projects` in profile.ts
const projectIcons = [
  'lucide:bot-message-square', // conversational AI platform
  'lucide:server', // high-throughput webservices
  'lucide:shopping-cart', // e-commerce integrations
];
---

<Base title="Projects — Vasile Grafu" description="Selected systems: enterprise AI platforms, high-throughput web services, and e-commerce integrations.">
  <p class="kicker">Selected systems</p>
  <h1 class="mt-2 font-display text-3xl font-bold text-slate-900 dark:text-white">Projects</h1>
  <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">
    The systems I’m proudest of — what they do, the scale they run at, and the architecture
    behind them.
  </p>

  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    {
      projects.map((p, i) => (
        <article class="card-lift rounded-xl border border-slate-200 dark:border-slate-800 p-6 flex flex-col">
          <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400">
            <Icon name={projectIcons[i]} class="h-5 w-5" aria-hidden="true" />
          </div>
          <h2 class="font-display text-lg font-semibold text-slate-900 dark:text-white">{p.title}</h2>
          <p class="mt-1 text-sm text-indigo-600 dark:text-indigo-400">{p.role}</p>
          <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300 grow">
            {p.description}
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            {p.tags.map((t) => (
              <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-3 py-1 text-xs text-slate-600 dark:text-slate-300">
                {t}
              </span>
            ))}
          </div>
        </article>
      ))
    }
  </div>

  <p class="mt-10 text-slate-600 dark:text-slate-300">
    Open-source experiments and AI demos are coming to this page — watch
    <a href="https://github.com/vasilegrafu" class="text-indigo-600 dark:text-indigo-400 hover:underline">my GitHub</a>.
  </p>
</Base>
