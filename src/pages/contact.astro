---
import Base from '../layouts/Base.astro';
import { site } from '../data/profile';
---

<Base title="Contact — Vasile Grafu" description="Get in touch with Vasile Grafu to exchange ideas on engineering leadership, AI systems, and research.">
  <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Contact</h1>
  <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">
    The most interesting things start with a good conversation — engineering leadership, agentic
    AI, research, or a problem you’re turning over. I read everything and reply to thoughtful
    messages.
  </p>

  <div class="mt-8 space-y-4 max-w-md">
    <a
      href={`mailto:${site.email}`}
      class="flex items-center justify-between rounded-xl border border-slate-200 dark:border-slate-800 p-5 hover:border-indigo-600 dark:hover:border-indigo-400 group"
    >
      <div>
        <p class="font-semibold text-slate-900 dark:text-white">Email</p>
        <p class="text-sm text-slate-600 dark:text-slate-400">{site.email}</p>
      </div>
      <span class="text-indigo-600 dark:text-indigo-400 opacity-0 group-hover:opacity-100">→</span>
    </a>
    <a
      href={site.linkedin}
      class="flex items-center justify-between rounded-xl border border-slate-200 dark:border-slate-800 p-5 hover:border-indigo-600 dark:hover:border-indigo-400 group"
    >
      <div>
        <p class="font-semibold text-slate-900 dark:text-white">LinkedIn</p>
        <p class="text-sm text-slate-600 dark:text-slate-400">Best for professional messages</p>
      </div>
      <span class="text-indigo-600 dark:text-indigo-400 opacity-0 group-hover:opacity-100">→</span>
    </a>
    <a
      href={site.github}
      class="flex items-center justify-between rounded-xl border border-slate-200 dark:border-slate-800 p-5 hover:border-indigo-600 dark:hover:border-indigo-400 group"
    >
      <div>
        <p class="font-semibold text-slate-900 dark:text-white">GitHub</p>
        <p class="text-sm text-slate-600 dark:text-slate-400">Code and experiments</p>
      </div>
      <span class="text-indigo-600 dark:text-indigo-400 opacity-0 group-hover:opacity-100">→</span>
    </a>
  </div>

  <p class="mt-8 text-sm text-slate-500 dark:text-slate-400">
    Based in {site.location} (EET, UTC+2).
  </p>
</Base>
