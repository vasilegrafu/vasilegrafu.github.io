---
import Base from '../layouts/Base.astro';
import { site } from '../data/profile';
---

<Base title="Contact — Vasile Grafu" description="Get in touch with Vasile Grafu to exchange ideas on engineering leadership, AI systems, and research.">
  <div class="relative">
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="absolute -top-16 -right-24 h-72 w-72 rounded-full bg-indigo-200/40 dark:bg-indigo-500/10 blur-3xl"></div>
      <div class="absolute top-48 -left-24 h-56 w-56 rounded-full bg-violet-200/30 dark:bg-violet-500/10 blur-3xl"></div>
    </div>

    <h1 class="font-display text-3xl font-bold text-slate-900 dark:text-white">Contact</h1>
    <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">
      I read everything and reply to thoughtful messages.
    </p>

    <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_20rem]">
      <div class="space-y-4">
        <a
          href={`mailto:${site.email}`}
          class="card-lift group flex items-center gap-4 rounded-xl border border-slate-200 dark:border-slate-800 p-5 hover:border-indigo-600 dark:hover:border-indigo-400"
        >
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path stroke-linecap="round" stroke-linejoin="round" d="m3 7 9 6 9-6" />
            </svg>
          </span>
          <span class="min-w-0 grow">
            <span class="block font-display font-semibold text-slate-900 dark:text-white">Email</span>
            <span class="block truncate text-sm text-slate-600 dark:text-slate-400">{site.email}</span>
          </span>
          <span class="shrink-0 text-slate-400 dark:text-slate-500 transition-all group-hover:translate-x-1 group-hover:text-indigo-600 dark:group-hover:text-indigo-400" aria-hidden="true">→</span>
        </a>

        <a
          href={site.linkedin}
          class="card-lift group flex items-center gap-4 rounded-xl border border-slate-200 dark:border-slate-800 p-5 hover:border-indigo-600 dark:hover:border-indigo-400"
        >
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.23 0Z"/></svg>
          </span>
          <span class="min-w-0 grow">
            <span class="block font-display font-semibold text-slate-900 dark:text-white">LinkedIn</span>
            <span class="block text-sm text-slate-600 dark:text-slate-400">Best for professional messages</span>
          </span>
          <span class="shrink-0 text-slate-400 dark:text-slate-500 transition-all group-hover:translate-x-1 group-hover:text-indigo-600 dark:group-hover:text-indigo-400" aria-hidden="true">→</span>
        </a>

        <a
          href={site.github}
          class="card-lift group flex items-center gap-4 rounded-xl border border-slate-200 dark:border-slate-800 p-5 hover:border-indigo-600 dark:hover:border-indigo-400"
        >
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.66.41.36.78 1.06.78 2.14 0 1.54-.02 2.79-.02 3.17 0 .31.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
          </span>
          <span class="min-w-0 grow">
            <span class="block font-display font-semibold text-slate-900 dark:text-white">GitHub</span>
            <span class="block text-sm text-slate-600 dark:text-slate-400">Code and experiments</span>
          </span>
          <span class="shrink-0 text-slate-400 dark:text-slate-500 transition-all group-hover:translate-x-1 group-hover:text-indigo-600 dark:group-hover:text-indigo-400" aria-hidden="true">→</span>
        </a>
      </div>

      <aside class="h-fit rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/40 p-6">
        <ul class="space-y-4 text-sm text-slate-600 dark:text-slate-300">
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" />
            </svg>
            <span>{site.location}</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2" />
            </svg>
            <span>EET (UTC+2)</span>
          </li>
        </ul>
      </aside>
    </div>
  </div>

</Base>
