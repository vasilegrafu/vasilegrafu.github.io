---
import Base from '../layouts/Base.astro';
import { experience, education, selfLearning } from '../data/profile';

const stats = [
  { value: '20+', label: 'years in software' },
  { value: '18', label: 'years leading teams' },
  { value: '4', label: 'companies' },
];

// Company eras for the ribbon; widths are proportional to duration.
const eras = [
  { company: 'Ubisoft', span: '’05–’08', years: 3.5 },
  { company: 'TeamNet', span: '’08–’09', years: 1 },
  { company: 'Consignor', span: '’09–’22', years: 13 },
  { company: 'nShift', span: '’22–now', years: 4.7, current: true },
];

// Inline icon per role, in the same order as `experience` (lucide outlines).
const roleIcons = [
  // nShift — sparkles
  '<path stroke-linecap="round" stroke-linejoin="round" d="M9.8 15.3 9 18l-.8-2.7a4 4 0 0 0-2.5-2.5L3 12l2.7-.8a4 4 0 0 0 2.5-2.5L9 6l.8 2.7a4 4 0 0 0 2.5 2.5l2.7.8-2.7.8a4 4 0 0 0-2.5 2.5ZM18 4l.4 1.6L20 6l-1.6.4L18 8l-.4-1.6L16 6l1.6-.4Zm0 10 .4 1.6L20 16l-1.6.4L18 18l-.4-1.6L16 16l1.6-.4Z"/>',
  // Consignor Team Manager — globe
  '<circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 3a13.9 13.9 0 0 0 0 18 13.9 13.9 0 0 0 0-18ZM3 12h18"/>',
  // Consignor Technical Lead — layers
  '<path stroke-linecap="round" stroke-linejoin="round" d="m12 3 9 4.5-9 4.5-9-4.5L12 3Zm-9 9 9 4.5 9-4.5m-18 4.5L12 21l9-4.5"/>',
  // TeamNet — package
  '<path stroke-linecap="round" stroke-linejoin="round" d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8Zm-17.7-1 8.7 5 8.7-5M12 22V12"/>',
  // Ubisoft — gamepad
  '<path stroke-linecap="round" stroke-linejoin="round" d="M6 12h4m-2-2v4m8-1h.01M15 11h.01M17.32 5H6.68a4 4 0 0 0-3.98 3.59C2.6 9.42 2 14.46 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.41-1.41A2 2 0 0 1 9.83 16h4.34a2 2 0 0 1 1.41.59L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.54-.6-6.58-.7-7.41A4 4 0 0 0 17.32 5Z"/>',
];
---

<Base title="Career — Vasile Grafu" description="20+ years in software: Ubisoft, TeamNet, Consignor, and nShift — from game programming to engineering management and AI systems.">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="kicker">Journey</p>
      <h1 class="mt-2 font-display text-3xl font-bold text-slate-900 dark:text-white">Career</h1>
      <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">
        The roles I’ve held, the teams I’ve built, and what each chapter added.
      </p>
    </div>
    <a
      href="/cv.pdf"
      download="Vasile-Grafu-Resume.pdf"
      class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-5 py-2.5 text-white font-medium shadow-sm hover:bg-indigo-700"
    >
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16" />
      </svg>
      Download resume (PDF)
    </a>
  </div>

  <div class="mt-8 grid grid-cols-2 sm:grid-cols-3 gap-4">
    {
      stats.map((s) => (
        <div class="rounded-xl border border-slate-200 dark:border-slate-800 p-4 text-center">
          <p class="font-display text-3xl font-bold bg-gradient-to-br from-indigo-600 to-violet-600 bg-clip-text text-transparent">
            {s.value}
          </p>
          <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{s.label}</p>
        </div>
      ))
    }
  </div>

  <div class="mt-6 flex flex-wrap sm:flex-nowrap gap-1.5" aria-label="Career timeline by company">
    {
      eras.map((e) => (
        <div
          class={`rounded-lg px-2.5 py-1.5 text-center text-xs whitespace-nowrap ${
            e.current
              ? 'bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-medium'
              : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300'
          }`}
          style={`flex-grow: ${e.years}; flex-basis: 0; min-width: fit-content;`}
        >
          {e.company} <span class={e.current ? 'text-indigo-100' : 'text-slate-400 dark:text-slate-500'}>{e.span}</span>
        </div>
      ))
    }
  </div>

  <ol class="mt-10 relative border-s border-slate-200 dark:border-slate-800 space-y-12">
    {
      experience.map((role, i) => (
        <li class="ms-6">
          <span class="absolute -start-3.5 mt-1 flex h-7 w-7 items-center justify-center rounded-full border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 text-indigo-600 dark:text-indigo-400">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true" set:html={roleIcons[i]} />
          </span>
          <p class="flex flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
            <span class="rounded-full bg-indigo-50 dark:bg-indigo-950/60 px-2.5 py-0.5 text-xs font-medium text-indigo-700 dark:text-indigo-300">{role.period}</span>
            {role.location}
          </p>
          <h2 class="mt-2 font-display text-xl font-semibold text-slate-900 dark:text-white">
            {role.position} · {role.company}
          </h2>
          <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-300">{role.summary}</p>
          <details class="mt-4">
            <summary class="inline-flex cursor-pointer select-none items-center gap-1.5 rounded-full border border-slate-200 dark:border-slate-700 px-4 py-1.5 text-sm font-medium text-indigo-600 dark:text-indigo-400 transition-colors hover:border-indigo-600 hover:bg-indigo-50/50 dark:hover:border-indigo-400 dark:hover:bg-indigo-950/40 list-none [&::-webkit-details-marker]:hidden">
              What I did
              <svg class="chev h-4 w-4 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <div class="mt-4 grid gap-3 sm:grid-cols-2">
              {role.bullets.map((b) => {
                const idx = b.indexOf(': ');
                const title = idx > 0 ? b.slice(0, idx) : null;
                const rest = idx > 0 ? b.slice(idx + 2) : b;
                const body = title ? rest.charAt(0).toUpperCase() + rest.slice(1) : rest;
                return (
                  <div class="card-lift rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 p-4">
                    {title && <p class="text-sm font-semibold text-slate-900 dark:text-white">{title}</p>}
                    <p class={`text-sm leading-relaxed text-slate-600 dark:text-slate-300 ${title ? 'mt-1' : ''}`}>{body}</p>
                  </div>
                );
              })}
            </div>
          </details>
          {role.tech && (
            <div class="mt-4 flex flex-wrap gap-2">
              {role.tech.map((t) => (
                <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-3 py-1 text-xs text-slate-600 dark:text-slate-300">
                  {t}
                </span>
              ))}
            </div>
          )}
        </li>
      ))
    }
  </ol>

  <h2 class="mt-14 font-display text-2xl font-bold text-slate-900 dark:text-white">Education</h2>
  <ul class="mt-4 space-y-4">
    {
      education.map((e) => (
        <li>
          <p class="font-medium text-slate-900 dark:text-white">{e.degree}</p>
          <p class="text-sm text-slate-500 dark:text-slate-400">{e.school} · {e.period}</p>
        </li>
      ))
    }
  </ul>

  <h2 class="mt-14 font-display text-2xl font-bold text-slate-900 dark:text-white">Self-learning</h2>
  <div class="mt-4 space-y-4 leading-relaxed text-slate-600 dark:text-slate-300">
    {selfLearning.map((p) => <p>{p}</p>)}
  </div>
</Base>
