---
import Base from '../layouts/Base.astro';
import { experience, education, selfLearning } from '../data/profile';
---

<Base title="Career — Vasile Grafu" description="20+ years in software: Ubisoft, TeamNet, Consignor, and nShift — from game programming to engineering management and AI systems.">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="kicker">Journey</p>
      <h1 class="mt-2 font-display text-3xl font-bold text-slate-900 dark:text-white">Career</h1>
      <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">
        The roles I’ve held, the teams I’ve built, and what each chapter added.
      </p>
    </div>
    <a
      href="/cv.pdf"
      download="Vasile-Grafu-Resume.pdf"
      class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-5 py-2.5 text-white font-medium shadow-sm hover:bg-indigo-700"
    >
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16" />
      </svg>
      Download resume (PDF)
    </a>
  </div>

  <ol class="mt-10 relative border-s border-slate-200 dark:border-slate-800 space-y-12">
    {
      experience.map((role) => (
        <li class="ms-6">
          <span class="absolute -start-1.5 mt-2 h-3 w-3 rounded-full bg-gradient-to-br from-indigo-600 to-violet-600" />
          <p class="flex flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
            <span class="rounded-full bg-indigo-50 dark:bg-indigo-950/60 px-2.5 py-0.5 text-xs font-medium text-indigo-700 dark:text-indigo-300">{role.period}</span>
            {role.location}
          </p>
          <h2 class="mt-2 font-display text-xl font-semibold text-slate-900 dark:text-white">
            {role.position} · {role.company}
          </h2>
          <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-300">{role.summary}</p>
          <ul class="mt-3 list-disc ps-5 space-y-1.5 text-slate-600 dark:text-slate-300">
            {role.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
          {role.tech && (
            <div class="mt-4 flex flex-wrap gap-2">
              {role.tech.map((t) => (
                <span class="rounded-full bg-slate-100 dark:bg-slate-800 px-3 py-1 text-xs text-slate-600 dark:text-slate-300">
                  {t}
                </span>
              ))}
            </div>
          )}
        </li>
      ))
    }
  </ol>

  <h2 class="mt-14 font-display text-2xl font-bold text-slate-900 dark:text-white">Education</h2>
  <ul class="mt-4 space-y-4">
    {
      education.map((e) => (
        <li>
          <p class="font-medium text-slate-900 dark:text-white">{e.degree}</p>
          <p class="text-sm text-slate-500 dark:text-slate-400">{e.school} · {e.period}</p>
        </li>
      ))
    }
  </ul>

  <h2 class="mt-14 font-display text-2xl font-bold text-slate-900 dark:text-white">Self-learning</h2>
  <p class="mt-4 leading-relaxed text-slate-600 dark:text-slate-300">{selfLearning}</p>

</Base>
