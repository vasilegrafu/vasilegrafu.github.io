---
import Base from '../layouts/Base.astro';
import { site, experience, skills, education, selfLearning } from '../data/profile';
---

<Base title="Resume — Vasile Grafu" description="Resume of Vasile Grafu: Engineering Manager, Solutions Architect, Enterprise & AI Systems.">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Resume</h1>
      <p class="mt-2 text-slate-600 dark:text-slate-300">{site.title}</p>
    </div>
    <a
      href="/cv.pdf"
      class="rounded-lg bg-indigo-600 px-5 py-2.5 text-white font-medium hover:bg-indigo-700"
      download="Vasile-Grafu-Resume.pdf"
    >
      Download PDF
    </a>
  </div>

  <div class="mt-4 text-sm text-slate-500 dark:text-slate-400">
    {site.location} · <a href={`mailto:${site.email}`} class="hover:text-indigo-600 dark:hover:text-indigo-400">{site.email}</a> ·
    <a href={site.linkedin} class="hover:text-indigo-600 dark:hover:text-indigo-400">LinkedIn</a> ·
    <a href={site.github} class="hover:text-indigo-600 dark:hover:text-indigo-400">GitHub</a>
  </div>

  <section class="mt-10">
    <h2 class="text-xl font-bold text-slate-900 dark:text-white border-b border-slate-200 dark:border-slate-800 pb-2">
      Skills
    </h2>
    <div class="mt-4 grid gap-x-8 gap-y-4 sm:grid-cols-2">
      {
        skills.map((s) => (
          <div>
            <h3 class="font-semibold text-slate-900 dark:text-white">{s.group}</h3>
            <ul class="mt-1.5 space-y-1 text-sm text-slate-600 dark:text-slate-300">
              {s.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold text-slate-900 dark:text-white border-b border-slate-200 dark:border-slate-800 pb-2">
      Experience
    </h2>
    <div class="mt-4 space-y-8">
      {
        experience.map((role) => (
          <div>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-semibold text-slate-900 dark:text-white">
                {role.position} · {role.company}
              </h3>
              <p class="text-sm text-slate-500 dark:text-slate-400">{role.period}</p>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{role.summary}</p>
            <ul class="mt-2 list-disc ps-5 space-y-1 text-sm text-slate-600 dark:text-slate-300">
              {role.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold text-slate-900 dark:text-white border-b border-slate-200 dark:border-slate-800 pb-2">
      Education
    </h2>
    <ul class="mt-4 space-y-3">
      {
        education.map((e) => (
          <li>
            <p class="font-medium text-slate-900 dark:text-white">{e.degree}</p>
            <p class="text-sm text-slate-500 dark:text-slate-400">{e.school} · {e.period}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold text-slate-900 dark:text-white border-b border-slate-200 dark:border-slate-800 pb-2">
      Self-learning
    </h2>
    <p class="mt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{selfLearning}</p>
  </section>
</Base>
