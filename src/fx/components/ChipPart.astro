---
// Small fact pill used in the home hero (icon + text).
import { Icon } from 'astro-icon/components';

interface Props {
  icon: string;
}

const { icon } = Astro.props;
---

<span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 dark:border-slate-700 bg-white/60 dark:bg-slate-900/60 px-3.5 py-1.5 text-slate-600 dark:text-slate-300">
  <Icon name={icon} class="h-3.5 w-3.5 text-indigo-600 dark:text-indigo-400" aria-hidden="true" />
  <slot />
</span>
