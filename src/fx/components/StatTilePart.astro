---
// Big gradient number over a small label, used in the Career "at a glance" row.
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="card p-4 text-center">
  <p
    class="font-display from-grad-a to-grad-b bg-gradient-to-br bg-clip-text text-3xl font-bold text-transparent"
  >
    {value}
  </p>
  <p class="text-faint mt-1 text-xs">{label}</p>
</div>
