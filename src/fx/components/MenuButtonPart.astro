---
// Hamburger button that opens the mobile menu panel (script in MobileMenu.astro).
import { Icon } from 'astro-icon/components';
---

<button
  id="menu-toggle"
  type="button"
  aria-label="Open menu"
  aria-expanded="false"
  class="sm:hidden inline-flex h-9 w-9 items-center justify-center rounded-lg border border-line-strong text-ink transition-colors hover:border-accent hover:text-accent"
>
  <Icon name="lucide:menu" id="menu-icon-open" class="h-5 w-5" aria-hidden="true" />
  <Icon name="lucide:x" id="menu-icon-close" class="hidden h-5 w-5" aria-hidden="true" />
</button>
