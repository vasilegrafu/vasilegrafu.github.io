---
// Large clickable contact channel card: icon tile, title, subtitle, hover arrow.
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  icon: string;
  title: string;
  subtitle: string;
}

const { href, icon, title, subtitle } = Astro.props;
---

<a href={href} class="card card-lift group hover:border-accent flex items-center gap-4 p-5">
  <span class="icon-tile h-11 w-11 shrink-0">
    <Icon name={icon} class="h-5 w-5" aria-hidden="true" />
  </span>
  <span class="min-w-0 grow">
    <span class="font-display text-ink block font-semibold">{title}</span>
    <span class="text-muted block truncate text-sm">{subtitle}</span>
  </span>
  <span
    class="text-faint group-hover:text-accent shrink-0 transition-all group-hover:translate-x-1"
    aria-hidden="true">→</span
  >
</a>
