---
// Large clickable contact channel card: icon tile, title, subtitle, hover arrow.
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  icon: string;
  title: string;
  subtitle: string;
}

const { href, icon, title, subtitle } = Astro.props;
---

<a
  href={href}
  class="card card-lift group flex items-center gap-4 p-5 hover:border-accent"
>
  <span class="icon-tile h-11 w-11 shrink-0">
    <Icon name={icon} class="h-5 w-5" aria-hidden="true" />
  </span>
  <span class="min-w-0 grow">
    <span class="block font-display font-semibold text-ink">{title}</span>
    <span class="block truncate text-sm text-muted">{subtitle}</span>
  </span>
  <span class="shrink-0 text-faint transition-all group-hover:translate-x-1 group-hover:text-accent" aria-hidden="true">→</span>
</a>
