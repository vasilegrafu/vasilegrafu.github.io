---
// Bordered card with an icon tile and title; body text goes in the slot.
// Used for the "What I do" grid on the home page and similar grids.
import { Icon } from 'astro-icon/components';

interface Props {
  icon: string;
  title: string;
}

const { icon, title }: Props = Astro.props;
---

<div class="card card-lift p-5">
  <div class="icon-tile">
    <Icon name={icon} class="h-5 w-5" aria-hidden="true" />
  </div>
  <h2 class="font-display text-ink mt-3 font-semibold">{title}</h2>
  <p class="text-muted mt-2 text-sm leading-relaxed">
    <slot />
  </p>
</div>
